# Игнорировать всё
*
~$*

# Но разрешить папки лабораторных
!лр1/
!лр2/
!лр3/
!лр4/
!лр5/

# Внутри лаб — только docx и код
!лр1/*.docx
!лр2/*.docx
!лр3/*.docx
!лр4/*.docx
!лр5/*.docx

# Не игнорировать сам .gitignore
!.gitignore

# Внутри лаб — разрешить папку проекта
!лр1/MyProject/
!лр2/MyProject/
!лр3/MyProject/
!лр4/MyProject/
!лр5/MyProject/

# И всё, что внутри этих папок
!лр1/MyProject/**
!лр2/MyProject/**
!лр3/MyProject/**
!лр4/MyProject/**
!лр5/MyProject/**

# Виртуальные окружения Python
.venv/
venv/
env/
ENV/
__pycache__/
*.pyc
*.pyo

# Шпоры / черновики — не нужны в репозитории
шп*.docx

# Временные файлы Word
~$*