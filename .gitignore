
# 1. Игнорировать ВСЁ

*


# 2. Разрешить папки лабораторных

!лр1/
!лр2/
!лр3/
!лр4/
!лр5/

# Разрешить папку MYpr в корне
!MYpr/
!MYpr/**

# 3. Разрешить документы и README в лабах

!лр*/*.docx
!лр*/README.md


# 4. Разрешить папки проектов внутри лаб
#    (замените имена на реальные!)

!лр1/MyProject/
!лр2/MyProject/
!лр3/MyProject/
!лр4/MyProject/
!лр5/MySite/


# 5. Разрешить всё содержимое этих папок

!лр1/MyProject/**
!лр2/MyProject/**
!лр3/MyProject/**
!лр4/MyProject/**
!лр5/MySite/**

MYpr/.venv/
MYpr/__pycache__/
MYpr/node_modules/
MYpr/.env

# 6. НО! Исключить мусор из проектов
#    (эти строки идут ПОСЛЕ разрешающих —
#     поэтому побеждают)


# Виртуальные окружения Python
.venv/
venv/
env/
ENV/
__pycache__/
*.pyc
*.pyo

# Node.js
node_modules/

# Django/Flask
*.log
db.sqlite3
db.sqlite3-journal
media/
staticfiles/
instance/
.pytest_cache/
.coverage

# Секреты и настройки IDE
.env
.idea/
.vscode/


# 7. Мусор в любом месте

шп*.docx
~$*


# 8. Не игнорировать сам .gitignore
!.gitignore